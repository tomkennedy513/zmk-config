#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    hold-while-undecided;
    require-prior-idle-ms = <50>;
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        bt {
            bindings = <&mo 4>;
            key-positions = <30 31>;
        };
    };

    behaviors {
        thumb_space: thumb_space {
            compatible = "zmk,behavior-hold-tap";
            tapping-term-ms = <120>;
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-while-undecided;
            flavor = "balanced";
            label = "THUMB_SPACE";
        };

        sk_qr: sk_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "SK_QUICK_RELEASE";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp Q  &kp W  &kp E  &kp R              &kp T    &kp Y  &kp U      &kp I      &kp O    &key_repeat
&kp A  &kp S  &kp D  &kp F              &kp G    &kp H  &kp J      &kp K      &kp L    &kp P
&kp Z  &kp X  &kp C  &kp V              &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp SINGLE_QUOTE
                     &sk_qr LEFT_SHIFT  &sl 1    &sl 2  &kp SPACE
            >;
        };

        Symbol {
            bindings = <
&kp EXCLAMATION  &kp AT     &kp POUND  &kp DOLLAR  &kp LEFT_BRACE      &kp RIGHT_BRACE    &kp AMPS     &kp QUESTION  &kp PIPE   &kp BACKSLASH
&kp GRAVE        &kp PLUS   &kp EQUAL  &kp COLON   &kp LPAR            &kp RPAR           &sk LGUI     &sk LALT      &sk LCTRL  &sk LSHFT
&kp ASTRK        &kp SLASH  &kp MINUS  &kp UNDER   &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp PERCENT  &kp CARET     &kp TILDE  &kp SEMI
                                       &trans      &trans              &trans             &trans
            >;
        };

        Nav {
            bindings = <
&none      &none      &none     &none     &none     &kp HOME         &kp PG_DN  &kp PG_UP  &kp END      &kp DEL
&sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &none     &kp LEFT         &kp DOWN   &kp UP     &kp RIGHT    &kp BACKSPACE
&none      &none      &none     &none     &none     &kp LS(LC(TAB))  &kp TAB    &kp ESC    &kp LC(TAB)  &kp ENTER
                                &trans    &trans    &trans           &trans
            >;
        };

        Number {
            bindings = <
&kp N1     &kp N2     &kp N3    &kp N4    &kp N5     &kp N6   &kp N7    &kp N8    &kp N9     &kp N0
&sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &kp F11    &kp F12  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT
&kp F1     &kp F2     &kp F3    &kp F4    &kp F5     &kp F6   &kp F7    &kp F8    &kp F9     &kp F10
                                &trans    &trans     &trans   &trans
            >;
        };

        Bluetooth {
            bindings = <
&none  &none  &none  &none   &none     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none   &none     &bt BT_CLR    &none         &none         &none         &none
&none  &none  &none  &none   &to 0     &none         &none         &none         &none         &studio_unlock
                     &trans  &trans    &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Number {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
