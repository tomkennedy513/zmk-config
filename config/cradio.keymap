#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&sk { release-after-ms = <1000>; };

&sl { release-after-ms = <300>; };

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE K_CANCEL>; };

/ {
    combos {
        compatible = "zmk,combos";

        bt {
            bindings = <&mo 4>;
            key-positions = <32 33>;
        };

        cmd {
            bindings = <&kp LCMD>;
            key-positions = <30 31>;
        };
    };

    behaviors {
        sk_qr: sk_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "SK_QUICK_RELEASE";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
    };

    macros {
        caps_word_with_release: caps_word_with_release {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&caps_word &kp K_CANCEL>;
            label = "CAPS_WORD_WITH_RELEASE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            bindings = <
&kp Q  &kp W  &kp E  &kp R              &kp T    &kp Y  &kp U      &kp I      &kp O    &key_repeat
&kp A  &kp S  &kp D  &kp F              &kp G    &kp H  &kp J      &kp K      &kp L    &kp P
&kp Z  &kp X  &kp C  &kp V              &kp B    &kp N  &kp M      &kp COMMA  &kp DOT  &kp SINGLE_QUOTE
                     &sk_qr LEFT_SHIFT  &sl 1    &sl 2  &kp SPACE
            >;
        };

        Symbol {
            bindings = <
&kp EXCLAMATION  &kp AT     &kp POUND  &kp DOLLAR      &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp AMPS     &kp QUESTION  &kp PIPE   &kp BACKSLASH
&kp GRAVE        &kp SLASH  &kp UNDER  &kp MINUS       &kp LPAR            &kp RPAR           &sk LGUI     &sk LALT      &sk LCTRL  &sk LSHFT
&kp ASTRK        &kp PLUS   &kp EQUAL  &kp COLON       &kp LEFT_BRACE      &kp RIGHT_BRACE    &kp PERCENT  &kp CARET     &kp TILDE  &kp SEMI
                                       &kp LEFT_SHIFT  &trans              &trans             &trans
            >;
        };

        Nav {
            bindings = <
&none      &none      &none     &none      &none                      &kp LS(LC(TAB))  &kp PG_DN  &kp PG_UP  &kp LC(TAB)  &kp DEL
&sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI   &caps_word_with_release    &kp LEFT         &kp DOWN   &kp UP     &kp RIGHT    &kp BACKSPACE
&none      &none      &none     &none      &none                      &kp HOME         &kp TAB    &kp ESC    &kp END      &kp ENTER
                                &kp LSHFT  &trans                     &trans           &trans
            >;
        };

        Number {
            bindings = <
&kp N1     &kp N2     &kp N3    &kp N4    &kp N5     &kp N6   &kp N7    &kp N8    &kp N9     &kp N0
&sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &kp F11    &kp F12  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT
&kp F1     &kp F2     &kp F3    &kp F4    &kp F5     &kp F6   &kp F7    &kp F8    &kp F9     &kp F10
                                &trans    &trans     &trans   &trans
            >;
        };

        Bluetooth {
            bindings = <
&none  &none  &none  &none   &none     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none   &none     &bt BT_CLR    &none         &none         &none         &none
&none  &none  &none  &none   &to 0     &none         &none         &none         &none         &studio_unlock
                     &trans  &trans    &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Number {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
